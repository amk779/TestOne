                soldiers: ["Israel Brito", "M. Cerqueira"]
            },
            {
                name: "EsqdPMont",
                soldiers: ["Narciso", "Travassos"]
            }
        ];

        // Função para renderizar as unidades
        function renderUnits(units) {
            const container = document.getElementById('unitsContainer');
            container.innerHTML = '';
            
            let totalSoldiers = 0;
            
            units.forEach(unit => {
                totalSoldiers += unit.soldiers.length;
                
                const unitCard = document.createElement('div');
                unitCard.className = 'unit-card';
                
                const unitHeader = document.createElement('div');
                unitHeader.className = 'unit-header';
                unitHeader.textContent = unit.name;
                
                const soldiersList = document.createElement('ul');
                soldiersList.className = 'soldiers-list';
                
                unit.soldiers.forEach(soldier => {
                    const li = document.createElement('li');
                    li.textContent = soldier;
                    soldiersList.appendChild(li);
                });
                
                unitCard.appendChild(unitHeader);
                unitCard.appendChild(soldiersList);
                container.appendChild(unitCard);
            });
            
            // Atualizar estatísticas
            document.getElementById('unitCount').textContent = units.length;
            document.getElementById('soldierCount').textContent = totalSoldiers;
        }
        
        // Função para pesquisar
        function search() {
            const searchTerm = document.getElementById('searchInput').value.toLowerCase();
            
            if (!searchTerm) {
                renderUnits(unitsData);
                return;
            }
            
            const filteredUnits = unitsData.map(unit => {
                // Verificar se o nome da unidade corresponde
                const unitNameMatch = unit.name.toLowerCase().includes(searchTerm);
                
                // Filtrar soldados que correspondem
                const filteredSoldiers = unit.soldiers.filter(soldier => 
                    soldier.toLowerCase().includes(searchTerm)
                );
                
                // Se a unidade corresponde ou tem soldados que correspondem
                if (unitNameMatch || filteredSoldiers.length > 0) {
                    return {
                        name: unit.name,
                        soldiers: unitNameMatch ? unit.soldiers : filteredSoldiers
                    };
                }
                
                return null;
            }).filter(unit => unit !== null);
            
            renderUnits(filteredUnits);
            
            // Destacar os termos pesquisados
            if (searchTerm) {
                const soldiers = document.querySelectorAll('.soldiers-list li');
                soldiers.forEach(soldier => {
                    const text = soldier.textContent.toLowerCase();
                    if (text.includes(searchTerm)) {
                        soldier.classList.add('highlight');
                    } else {
                        soldier.classList.remove('highlight');
                    }
                });
                
                const units = document.querySelectorAll('.unit-header');
                units.forEach(unit => {
                    const text = unit.textContent.toLowerCase();
                    if (text.includes(searchTerm)) {
                        unit.style.backgroundColor = '#e74c3c';
                    } else {
                        unit.style.backgroundColor = '#3498db';
                    }
                });
            }
        }
        
        // Event listeners
        document.getElementById('searchInput').addEventListener('input', search);
        
        // Renderizar inicialmente
        renderUnits(unitsData);
    </script>
</body>
</html>